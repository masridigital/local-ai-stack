# Non-secret runtime settings. install.sh copies deploy/env/*.env to /etc/<app>/config.env (mode 0600).
# Secrets stay in separate LoadCredential files, not in this file.

VPN_BIND_IP=127.0.0.1
WEBUI_URL=https://webui.lan.internal
AZURE_OPENAI_REGION=eastus2
AZURE_OPENAI_MODEL_FAMILY=gpt-4.1
AZURE_OPENAI_DEPLOYMENT=
AZURE_API_BASE=https://example.openai.azure.com/
AZURE_API_HOST=
AZURE_API_VERSION=2024-10-21
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
OPENID_PROVIDER_URL=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0/.well-known/openid-configuration
ANTHROPIC_BAA_ENABLED=false
ALLOW_AZURE_AI_THIRD_PARTY=false
FOUNDRY_ABUSE_MONITORING_OPT_OUT=false
CHAT_RETENTION_DAYS=30
VPN_SSH_CIDR=10.0.0.0/24
DNS_SERVERS=
SIEM_HOST=
SIEM_PORT=
STACKJACK_MCP_HOST=
COMPOSIO_MCP_HOST=
CONFIG_ACTOR=system:deploy
