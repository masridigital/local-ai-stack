-w /etc/ssh/sshd_config -p wa -k sshd_config
-w /etc/ssh/sshd_config.d/ -p wa -k sshd_config
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers
-w /etc/fstab -p wa -k mounts
-w /etc/crypttab -p wa -k mounts
-w /etc/ufw/ -p wa -k ufw
-w /etc/sysctl.d/ -p wa -k sysctl
-w /etc/litellm/ -p wa -k secrets
-w /etc/open-webui/ -p wa -k secrets
-w /etc/policy-gateway/ -p wa -k secrets
-w /etc/postgres/ -p wa -k secrets
-w /usr/bin/sudo -p x -k privileged
-w /usr/bin/su -p x -k privileged
-w /usr/bin/chown -p x -k privileged
-w /usr/bin/chmod -p x -k privileged
-w /usr/bin/passwd -p x -k privileged
