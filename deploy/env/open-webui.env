ENV=prod
WEBUI_URL=https://webui.lan.internal
ENABLE_PERSISTENT_CONFIG=false
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=false
ENABLE_PASSWORD_AUTH=false
# JIT accounts exist only for people Entra already accepted. The enterprise app
# requires assignment and is assigned only to the local-ai-users group.
ENABLE_OAUTH_SIGNUP=true
DEFAULT_USER_ROLE=pending
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
# Bootstrap account so the first Entra login is not promoted to admin.
# The password is a LoadCredential, and the login form stays off.
WEBUI_ADMIN_EMAIL=webui-bootstrap@local-ai.internal
WEBUI_ADMIN_NAME=Bootstrap
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_TENANT_ID=f7812296-5bce-41dc-8102-b1b270e7c4c7
MICROSOFT_OAUTH_SCOPE=openid email profile offline_access
OPENID_PROVIDER_URL=https://login.microsoftonline.com/f7812296-5bce-41dc-8102-b1b270e7c4c7/v2.0/.well-known/openid-configuration
OAUTH_CODE_CHALLENGE_METHOD=S256
OAUTH_REFRESH_TOKEN_INCLUDE_SCOPE=true
ENABLE_OAUTH_ROLE_MANAGEMENT=true
OAUTH_ROLES_CLAIM=roles
OAUTH_ALLOWED_ROLES=phi,non-phi,admin
OAUTH_ADMIN_ROLES=admin
ENABLE_OAUTH_GROUP_MANAGEMENT=true
OAUTH_GROUPS_CLAIM=roles
ENABLE_OAUTH_GROUP_CREATION=true
OAUTH_GROUP_DEFAULT_SHARE=false
OAUTH_AUTO_REDIRECT=true
OPENAI_API_CONFIGS={"0":{"headers":{"X-Entra-App-Roles":"{{USER_GROUPS}}"}}}
JWT_EXPIRES_IN=8h
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_AUTH=true
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true
ENABLE_OPENAI_API_PASSTHROUGH=false
OPENAI_API_BASE_URL=http://127.0.0.1:8088/v1
ENABLE_DIRECT_CONNECTIONS=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_IMAGE_GENERATION=false
ENABLE_CODE_INTERPRETER=false
ENABLE_ADMIN_EXPORT=false
ENABLE_ADMIN_CHAT_ACCESS=false
ENABLE_WEB_SEARCH=false
ENABLE_RAG_WEB_SEARCH=false
ENABLE_RAG_LOCAL_WEB_FETCH=false
RAG_EMBEDDING_ENGINE=
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USER_PERMISSIONS_CHAT_FILE_UPLOAD=false
USER_PERMISSIONS_CHAT_WEB_UPLOAD=false
USER_PERMISSIONS_WORKSPACE_KNOWLEDGE_ACCESS=false
USER_PERMISSIONS_WORKSPACE_TOOLS_ACCESS=false
ENABLE_KNOWLEDGE_FILE_RETENTION=false
GLOBAL_LOG_LEVEL=WARNING
LOGURU_DIAGNOSE=false
AUDIT_LOG_LEVEL=METADATA
ENABLE_AUDIT_STDOUT=false
ENABLE_FORWARD_USER_INFO_HEADERS=true
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=1
ANONYMIZED_TELEMETRY=false
CHAT_RETENTION_DAYS=30
DATA_DIR=/var/lib/local-ai-stack/webui
HF_HOME=/var/lib/local-ai-stack/webui/hf
SENTENCE_TRANSFORMERS_HOME=/var/lib/local-ai-stack/webui/st
