LITELLM_LOG=ERROR
PRESIDIO_ANALYZER_API_BASE=http://127.0.0.1:3000
PRESIDIO_ANONYMIZER_API_BASE=http://127.0.0.1:3001
AZURE_OPENAI_DEPLOYMENT=
AZURE_API_BASE=https://example.openai.azure.com
AZURE_API_VERSION=2024-10-21
# Azure OpenAI uses the API key in /etc/litellm/azure_api_key (mode 0600).
# Do not set a client id or client secret here. That login is not used.
