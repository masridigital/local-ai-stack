LITELLM_LOG=ERROR
PRESIDIO_ANALYZER_API_BASE=http://127.0.0.1:3000
PRESIDIO_ANONYMIZER_API_BASE=http://127.0.0.1:3001
AZURE_OPENAI_DEPLOYMENT=
AZURE_API_BASE=https://example.openai.azure.com
AZURE_API_VERSION=2024-10-21
# LiteLLM Foundry name for the Entra tenant. Open WebUI uses MICROSOFT_CLIENT_TENANT_ID.
# Do not copy AZURE_TENANT_ID into the Open WebUI env file. Set both to the same tenant.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
