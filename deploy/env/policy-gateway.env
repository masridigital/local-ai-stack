ANTHROPIC_BAA_ENABLED=false
ALLOW_AZURE_AI_THIRD_PARTY=false
FOUNDRY_ABUSE_MONITORING_OPT_OUT=false
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL_FAMILY=gpt-4.1
AZURE_OPENAI_REGION=eastus2
AZURE_API_BASE=https://example.openai.azure.com
AZURE_API_VERSION=2024-10-21
# Same tenant as Open WebUI MICROSOFT_CLIENT_TENANT_ID. This name is Foundry-only.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
CONFIG_ACTOR=system:deploy
PRESIDIO_TIMEOUT=5
BIND_HOST=127.0.0.1
GATEWAY_PORT=8088
