# Example only. Copy to /etc/wireguard/wg0.conf and set mode 0600 on the host.
# The private key stays in that file. Do not commit one.
# install.sh installs the wireguard package and does not start a tunnel
# unless /etc/wireguard/wg0.conf already exists.

[Interface]
Address = 10.0.0.2/24

[Peer]
Endpoint = vpn.example.internal:51820
AllowedIPs = 10.0.0.0/24
PersistentKeepalive = 25
