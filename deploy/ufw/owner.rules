# Owner-matched OUTPUT rules. Proxy ports are uid-locked before loopback accept.
# Apt and MCP names are checked on their own proxy ports. DNS, NTP, and optional SIEM stay uid accepts.
# DHCPv4 renew is sport 68 to dport 67. IPv6 ND and DHCPv6 are in owner6.rules.
# Hostnames are comments here. They are not firewall matches.
# proxy for openwebui -> login.microsoftonline.com:443/tcp
# proxy for openwebui -> login.microsoft.com:443/tcp
# proxy for root -> archive.ubuntu.com:80/tcp
# proxy for root -> archive.ubuntu.com:443/tcp
# proxy for root -> security.ubuntu.com:80/tcp
# proxy for root -> security.ubuntu.com:443/tcp
# proxy for root -> dl.cloudsmith.io:443/tcp
# proxy for systemd-timesync -> ntp.ubuntu.com:123/udp
-A ufw-before-output -m owner --uid-owner openwebui -d 127.0.0.2 -p tcp --dport 4000 -j REJECT
-A ufw-before-output -m owner --uid-owner openwebui -d 127.0.0.1 -p tcp --dport 4000 -j REJECT
-A ufw-before-output -d 127.0.0.1 -p tcp --dport 8888 -m owner ! --uid-owner openwebui -j REJECT
-A ufw-before-output -d 127.0.0.1 -p tcp --dport 8889 -m owner ! --uid-owner litellm -j REJECT
-A ufw-before-output -d 127.0.0.1 -p tcp --dport 8890 -m owner --uid-owner root -j ACCEPT
-A ufw-before-output -d 127.0.0.1 -p tcp --dport 8890 -m owner --uid-owner _apt -j ACCEPT
-A ufw-before-output -d 127.0.0.1 -p tcp --dport 8890 -j REJECT
-A ufw-before-output -d 127.0.0.1 -p tcp --dport 8891 -m owner ! --uid-owner policy-gateway -j REJECT
-A ufw-before-output -o lo -j ACCEPT
-A ufw-before-output -m owner --uid-owner egress-proxy -p tcp --dport 80 -j ACCEPT
-A ufw-before-output -m owner --uid-owner egress-proxy -p tcp --dport 443 -j ACCEPT
-A ufw-before-output -m owner --uid-owner egress-proxy -p udp --dport 53 -j ACCEPT
-A ufw-before-output -m owner --uid-owner egress-proxy -p tcp --dport 53 -j ACCEPT
-A ufw-before-output -m owner --uid-owner systemd-resolve -p udp --dport 53 -j ACCEPT
-A ufw-before-output -m owner --uid-owner systemd-resolve -p tcp --dport 53 -j ACCEPT
-A ufw-before-output -m owner --uid-owner systemd-timesync -p udp --dport 123 -j ACCEPT
-A ufw-before-output -p udp --sport 68 --dport 67 -j ACCEPT
-A ufw-before-output -m owner --uid-owner presidio-analyzer -j REJECT
-A ufw-before-output -m owner --uid-owner presidio-anonymizer -j REJECT
-A ufw-before-output -m owner --uid-owner policy-gateway -j REJECT
-A ufw-before-output -m owner --uid-owner postgres -j REJECT
-A ufw-before-output -m owner --uid-owner caddy -j REJECT
-A ufw-before-output -m owner --uid-owner litellm -j REJECT
-A ufw-before-output -m owner --uid-owner openwebui -j REJECT
