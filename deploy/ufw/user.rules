# Host allowlist. install.sh installs these as owner-matched OUTPUT rules, not global allows.
# Optional hosts are added only when their env var is set. cloudflared stays off.
default deny incoming
default deny outgoing
# user openwebui
allow out to login.microsoftonline.com port 443 proto tcp
allow out to login.microsoft.com port 443 proto tcp
# user root
allow out to archive.ubuntu.com port 80 proto tcp
allow out to archive.ubuntu.com port 443 proto tcp
allow out to security.ubuntu.com port 80 proto tcp
allow out to security.ubuntu.com port 443 proto tcp
# user root
allow out to dl.cloudsmith.io port 443 proto tcp
# user root
allow out to pkg.cloudflare.com port 443 proto tcp
# user systemd-timesync
allow out to time.cloudflare.com port 123 proto udp
