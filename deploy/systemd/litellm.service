[Unit]
Description=LiteLLM proxy (loopback only)
# listen 127.0.0.2:4000
After=network-online.target postgresql.service presidio-analyzer.service presidio-anonymizer.service
Wants=network-online.target postgresql.service presidio-analyzer.service presidio-anonymizer.service

[Service]
Type=simple
User=litellm
Group=litellm
WorkingDirectory=/var/lib/local-ai-stack/litellm
EnvironmentFile=/etc/litellm/config.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/local-ai-stack/litellm
Environment=LITELLM_LOG=ERROR
Environment=BIND_HOST=127.0.0.2
LoadCredential=litellm_master_key:/etc/litellm/litellm_master_key
LoadCredential=anthropic_api_key:/etc/litellm/anthropic_api_key
LoadCredential=azure_client_secret:/etc/litellm/azure_client_secret
LoadCredential=database_url:/etc/litellm/database_url
ExecStart=/opt/litellm/litellm-run.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
ReadWritePaths=/var/lib/local-ai-stack/litellm
# Off-host egress is owner-matched UFW/nftables with resolved addresses.
# systemd IPAddressAllow does not accept hostnames, so it is not used here.

[Install]
WantedBy=local-ai-stack.target
