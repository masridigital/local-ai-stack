[Unit]
Description=Open WebUI (loopback only; TLS is Caddy)
# listen 127.0.0.1:8080
After=network-online.target policy-gateway.service
Wants=network-online.target policy-gateway.service

[Service]
Type=simple
User=openwebui
Group=openwebui
WorkingDirectory=/var/lib/local-ai-stack/webui
EnvironmentFile=/etc/open-webui/config.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/local-ai-stack/webui
Environment=HF_HOME=/var/lib/local-ai-stack/webui/hf
Environment=SENTENCE_TRANSFORMERS_HOME=/var/lib/local-ai-stack/webui/st
Environment=DATA_DIR=/var/lib/local-ai-stack/webui
LoadCredential=webui_secret_key:/etc/open-webui/webui_secret_key
LoadCredential=webui_admin_password:/etc/open-webui/webui_admin_password
LoadCredential=microsoft_client_secret:/etc/open-webui/microsoft_client_secret
LoadCredential=gateway_client_key:/etc/open-webui/gateway_client_key
ExecStart=/opt/open-webui/open-webui-run.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
ReadWritePaths=/var/lib/local-ai-stack/webui
# Deny the LiteLLM address. Entra egress is a UFW owner rule with resolved IPs,
# because systemd ignores hostnames in IPAddressAllow.
IPAddressDeny=127.0.0.2

[Install]
WantedBy=local-ai-stack.target
