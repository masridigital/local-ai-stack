[Unit]
Description=Load local-ai egress filter before the network is configured
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=LOCAL_AI_ROOT=@LOCAL_AI_ROOT@
EnvironmentFile=-/etc/local-ai-stack/egress.env
ExecStart=/usr/local/sbin/local-ai-egress-refresh --nft-only

[Install]
WantedBy=network-pre.target
