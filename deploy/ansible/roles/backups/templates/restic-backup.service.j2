[Unit]
Description=Encrypted restic backup of the local AI stack
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/var/lib/local-ai-stack/backups
EnvironmentFile={{ backups_env_file }}
ExecStart=/usr/local/sbin/local-ai-restic-backup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/local-ai-stack/backups
ReadOnlyPaths=/var/lib/local-ai-stack/webui /etc/restic
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID
UMask=0077
Nice=10

[Install]
WantedBy=multi-user.target
