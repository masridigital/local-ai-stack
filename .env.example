POSTGRES_PASSWORD=example-not-a-secret
DATABASE_URL=postgresql://localai:example-not-a-secret@127.0.0.1:5432/litellm
AUDIT_DATABASE_URL=postgresql://localai:example-not-a-secret@127.0.0.1:5432/litellm
WEBUI_SECRET_KEY=example-not-a-secret
MICROSOFT_CLIENT_SECRET=example-not-a-secret
CLOUDFLARED_CREDENTIALS_JSON={"AccountTag":"example","TunnelSecret":"example-not-a-secret","TunnelID":"00000000-0000-0000-0000-000000000000"}
