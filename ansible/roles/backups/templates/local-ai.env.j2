RESTIC_REPOSITORY={{ backups_repository }}
RESTIC_PASSWORD_FILE={{ backups_password_file }}
RESTIC_CACHE_DIR=/var/lib/local-ai-stack/backups/cache
LOCAL_AI_DATA_ROOT=/var/lib/local-ai-stack
RESTIC_KEEP_WITHIN_EPHI={{ backups_keep_within_ephi }}
RESTIC_KEEP_WITHIN_AUDIT={{ backups_keep_within_audit }}
{% if backups_offsite_repository | length > 0 %}
RESTIC_OFFSITE_REPOSITORY={{ backups_offsite_repository }}
{% endif %}
{% for key, value in backups_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
