# Alert route. journal is the default and stays on this host.
# This file must not contain the restic password.
LOCAL_AI_RESTIC_ALERT_ROUTE={{ backups_alert_route }}
{% if backups_alert_hook | trim | length > 0 %}
LOCAL_AI_RESTIC_ALERT_HOOK={{ backups_alert_hook }}
{% endif %}
{% if backups_alert_mail | trim | length > 0 %}
LOCAL_AI_RESTIC_ALERT_MAIL={{ backups_alert_mail }}
{% endif %}
